{
  "name": "zhuzhiliao",
  "version": "0.1.2",
  "description": "A physics-driven bamboo cicada that floats over any web page.",
  "keywords": ["zhuzhiliao", "bamboo-cicada", "web-component", "web-audio", "physical-modeling", "physics", "toy"],
  "author": "Yuzhe Shi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkmashiro/bamboo-cicada.git"
  },
  "homepage": "https://bkmashiro.github.io/bamboo-cicada/",
  "bugs": {
    "url": "https://github.com/bkmashiro/bamboo-cicada/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/bamboo-cicada.umd.cjs",
  "module": "./dist/bamboo-cicada.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bamboo-cicada.js",
      "require": "./dist/bamboo-cicada.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "pnpm pack --pack-destination .artifacts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
